#!/bin/bash -e

if [ -z "${LD_PRELOAD+x}" ]; then
  LD_PRELOAD=$(find /usr/lib -name libjemalloc.so.2 -print -quit)
  export LD_PRELOAD
fi

if [ "${RAILS_ENV:-}" = "production" ]; then
  # SAFE: migrate the application's dedicated database only.
  # NEVER seed test accounts, example passwords or fictional posts on boot.
  ./bin/rails db:prepare
fi

exec "${@}"
