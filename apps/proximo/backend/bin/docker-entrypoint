#!/bin/bash -e

if [ -z "${LD_PRELOAD+x}" ]; then
  LD_PRELOAD=$(find /usr/lib -name libjemalloc.so.2 -print -quit)
  export LD_PRELOAD
fi

if [ "${RAILS_ENV:-}" = "production" ]; then
  # SAFE: migrate the application's already-created dedicated database only.
  # Rails db:prepare can run seeds on first boot: NEVER use it in production.
  # No sample accounts, predictable passwords or fictional posts are created.
  ./bin/rails db:migrate
fi

exec "${@}"
